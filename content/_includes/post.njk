---
layout: base.njk
ogType: article
---
<article class="wrap">

  <header class="art-head">
    {% if tags and tags.length %}<a class="eyebrow" style="text-decoration:none" href="/articles/tag/{{ tags[0] | slug }}/">{{ tags[0] }}</a>{% else %}<span class="eyebrow">Article</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="art-sub">{{ subtitle }}</p>{% endif %}

    <div class="art-meta">
      <span class="meta">
        <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      </span>
      <span class="meta">{{ content | readingTime }} min read</span>
      {% if tags and tags.length %}
      <span class="tags">
        {% for tag in tags %}<a class="tag" href="/articles/tag/{{ tag | slug }}/">{{ tag }}</a>{% endfor %}
      </span>
      {% endif %}
    </div>

    {% if image %}
    <div class="art-hero">
      <img src="{{ image }}" alt="{{ imageAlt or title }}" width="1200" height="630">
    </div>
    {% endif %}
  </header>

  <div class="art-body">
    {{ content | safe }}
  </div>

  {% if source %}
  <p class="art-source">
    A version of this article also appears on <a href="{{ source }}" rel="nofollow">{{ sourceName or "Substack" }}</a>.
  </p>
  {% endif %}

  <div class="art-foot">
    <a class="back" href="/articles/">← All articles</a>
    <a class="nav-cta" href="/intake">Start A Project</a>
  </div>

</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  {% if subtitle %}"alternativeHeadline": {{ subtitle | dump | safe }},{% endif %}
  "description": {{ (description or site.description) | dump | safe }},
  "image": [{{ ((image or site.defaultOgImage) | absolute) | dump | safe }}],
  "datePublished": {{ (page.date | isoDate) | dump | safe }},
  "dateModified": {{ (page.date | isoDate) | dump | safe }},
  "author": { "@type": "Person", "name": {{ site.author | dump | safe }}, "url": {{ site.url | dump | safe }} },
  "publisher": { "@type": "Organization", "name": {{ site.title | dump | safe }}, "url": {{ site.url | dump | safe }} },
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ (canonical or (page.url | pub | absolute)) | dump | safe }} }
  {%- if tags and tags.length %},
  "keywords": {{ (tags | join(", ")) | dump | safe }}
  {%- endif %}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site.url | dump | safe }} },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": {{ ("/articles/" | absolute) | dump | safe }} },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": {{ (page.url | pub | absolute) | dump | safe }} }
  ]
}
</script>
