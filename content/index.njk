---
layout: base.njk
permalink: index.html
title: Articles
metaTitle: Articles — Vieren
description: Notes on building companies, film, content systems, and the machinery behind them.
eleventyComputed:
  # Keep an empty listing out of Google. Clears itself on the first published post.
  noindex: "{{ true if not collections.posts.length else false }}"
---
<div class="wrap">

  <header class="list-hero">
    <span class="eyebrow">Vieren</span>
    <h1>Articles</h1>
    <p>{{ description }}</p>

    {% if collections.tagList.length %}
    <div class="tags list-tags">
      {% for entry in collections.tagList %}
      <a class="tag" href="/articles/tag/{{ entry.tag | slug }}/">{{ entry.tag }} ({{ entry.count }})</a>
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="post-list">
    {% for post in collections.posts %}
    <a class="post-item" href="{{ post.url | pub }}">
      <span class="meta">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      </span>
      <h2>{{ post.data.title }}</h2>
      {% if post.data.subtitle %}<p>{{ post.data.subtitle }}</p>
      {% elif post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
      {% if post.data.tags and post.data.tags.length %}
      <span class="meta">{{ post.data.tags | join(" · ") }}</span>
      {% endif %}
    </a>
    {% else %}
    <p class="empty">No articles published yet.</p>
    {% endfor %}
  </div>

</div>
