---
layout: base.njk
permalink: index.html
title: Articles
metaTitle: Articles — Vieren
description: Notes on building companies, film, content systems, and the machinery behind them.
---
<div class="wrap wrap-wide">

  <header class="list-hero">
    <span class="eyebrow">Vieren</span>
    <h1>Articles</h1>
    <p>{{ collections.posts.length }} {% if collections.posts.length == 1 %}note{% else %}notes{% endif %} on building companies, film, content systems, and the machinery behind them.</p>
  </header>

  {% if collections.posts.length %}
    {% set featured = collections.posts[0] %}
    <a class="featured" href="{{ featured.url | pub }}">
      <span class="feat-eyebrow">Featured</span>
      <h2>{{ featured.data.title }}</h2>
      <p>{{ featured.data.subtitle or featured.data.description }}</p>
      <span class="feat-meta">{{ featured.templateContent | readingTime }} min read   {{ featured.date | shortDate }}</span>
    </a>

    {% if collections.tagList.length %}
    <div class="list-tags">
      {% for entry in collections.tagList %}
      <a class="tag" href="/articles/tag/{{ entry.tag | slug }}/">{{ entry.tag }} ({{ entry.count }})</a>
      {% endfor %}
    </div>
    {% endif %}

    <span class="grid-label">All articles</span>
    <div class="post-grid">
      {% for post in collections.posts %}
      <a class="post-card" href="{{ post.url | pub }}">
        <h2>{{ post.data.title }}</h2>
        <span class="pm">{{ post.templateContent | readingTime }} min read   {{ post.date | shortDate }}</span>
      </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="empty">No articles published yet.</p>
  {% endif %}

</div>
