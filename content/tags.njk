---
layout: base.njk
pagination:
  data: collections.postsByTag
  size: 1
  alias: group
eleventyComputed:
  title: "{{ group.tag }}"
  metaTitle: "{{ group.tag }} — Articles — Vieren"
  description: "Articles tagged {{ group.tag }}."
  permalink: "tag/{{ group.tag | slug }}/index.html"
---
<div class="wrap wrap-wide">

  <header class="list-hero">
    <a class="eyebrow" style="text-decoration:none" href="/articles/">Articles</a>
    <h1>{{ group.tag }}</h1>
    <p>{{ group.posts.length }} article{% if group.posts.length != 1 %}s{% endif %} tagged &ldquo;{{ group.tag }}&rdquo;.</p>
  </header>

  <div class="post-grid">
    {% for post in group.posts %}
    <a class="post-card" href="{{ post.url | pub }}">
      <h2>{{ post.data.title }}</h2>
      <span class="pm">{{ post.templateContent | readingTime }} min read   {{ post.date | shortDate }}</span>
    </a>
    {% endfor %}
  </div>

  <div class="art-foot">
    <a class="back" href="/articles/">← All articles</a>
  </div>

</div>
